# CLI本地产物根目录
HONGTAI_WORKSPACE_DIR=./workspace

# debug | info | warn | error
HONGTAI_LOG_LEVEL=info

# OpenAI兼容AI配置（不内置默认供应商，以下值均需显式填写）
HONGTAI_AI_BASE_URL=
HONGTAI_AI_API_KEY=
HONGTAI_TEXT_MODEL=
HONGTAI_VISION_MODEL=
HONGTAI_ASR_MODEL=
HONGTAI_AI_JSON_OBJECT=true
# 仅在供应商明确支持response_format=json_schema时开启
HONGTAI_AI_JSON_SCHEMA=false
HONGTAI_AI_ASR_TRANSPORT=audio-transcriptions
HONGTAI_AI_CONTEXT_WINDOW_TOKENS=32000

# 首版默认只处理20分钟以内的视频
HONGTAI_MAX_DURATION_SECONDS=1200

# 可选：本地工具与模型路径，当前CLI通过PATH发现FFmpeg
HONGTAI_FFMPEG_PATH=
HONGTAI_ASR_MODEL_DIR=./workspace/models
