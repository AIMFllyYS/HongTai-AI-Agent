# CLI本地产物根目录
HONGTAI_WORKSPACE_DIR=./workspace

# debug | info | warn | error
HONGTAI_LOG_LEVEL=info

# 小米MiMo或兼容的自定义AI配置
HONGTAI_AI_BASE_URL=https://api.xiaomimimo.com/v1
HONGTAI_AI_API_KEY=
HONGTAI_ASR_MODEL=mimo-v2.5-asr
HONGTAI_TEXT_MODEL=mimo-v2.5

# 首版默认只处理20分钟以内的视频
HONGTAI_MAX_DURATION_SECONDS=1200

# 可选：本地工具与模型路径，当前CLI通过PATH发现FFmpeg
HONGTAI_FFMPEG_PATH=
HONGTAI_ASR_MODEL_DIR=./workspace/models
